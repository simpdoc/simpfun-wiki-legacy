{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/web",
      "destination": "/docs/web/intro",
      "statusCode": 301
    },
    {
      "source": "/web/*",
      "destination": "/docs/web/:splat",
      "statusCode": 301
    },
    {
      "source": "/docs/web",
      "destination": "/docs/web/intro",
      "statusCode": 301
    },
    {
      "source": "/mcje",
      "destination": "/docs/mcje/select_server",
      "statusCode": 301
    },
    {
      "source": "/mcje/*",
      "destination": "/docs/mcje/:splat",
      "statusCode": 301
    },
    {
      "source": "/docs/mcje",
      "destination": "/docs/mcje/select_server",
      "statusCode": 301
    },
    {
      "source": "/mcbe",
      "destination": "/docs/mcbe/select_server",
      "statusCode": 301
    },
    {
      "source": "/mcbe/*",
      "destination": "/docs/mcbe/:splat",
      "statusCode": 301
    },
    {
      "source": "/docs/mcbe",
      "destination": "/docs/mcbe/select_server",
      "statusCode": 301
    },
    {
      "source": "/terraria",
      "destination": "/docs/terraria",
      "statusCode": 301
    },
    {
      "source": "/terraria/*",
      "destination": "/docs/terraria/:splat",
      "statusCode": 301
    },
    {
      "source": "/mindustry",
      "destination": "/docs/mindustry",
      "statusCode": 301
    },
    {
      "source": "/mindustry/*",
      "destination": "/docs/mindustry/:splat",
      "statusCode": 301
    },
    {
      "source": "/rusted-warfare",
      "destination": "/docs/rusted-warfare",
      "statusCode": 301
    },
    {
      "source": "/rusted-warfare/*",
      "destination": "/docs/rusted-warfare/:splat",
      "statusCode": 301
    },
    {
      "source": "/custom-image",
      "destination": "/docs/custom-image/multi_env/quick_start",
      "statusCode": 301
    },
    {
      "source": "/custom-image/*",
      "destination": "/docs/custom-image/:splat",
      "statusCode": 301
    },
    {
      "source": "/docs/custom-image",
      "destination": "/docs/custom-image/multi_env/quick_start",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/llms.mdx/*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/docs",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/docs/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
